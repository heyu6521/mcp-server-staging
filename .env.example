NODE_ENV=development
HOST=127.0.0.1
PORT=3000
AUTH_MODE=none
MCP_PRINCIPAL=chatgpt-business-workspace
MCP_TOOLSETS=default
MCP_TOOLS=
MCP_EXCLUDE_TOOLS=
MCP_READ_ONLY=false
MCP_LOCKDOWN_MODE=true
FORGEJO_BASE_URL=http://forgejo.invalid
FORGEJO_TOKEN=
REPOSITORY_POLICY_FILE=/run/config/repositories.yaml
CONFIRMATION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=
MAX_CONCURRENCY=4
RATE_LIMIT_PER_MINUTE=60
WRITE_RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_MS=15000
LONG_REQUEST_TIMEOUT_MS=30000
